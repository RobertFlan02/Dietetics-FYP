        "import matplotlib.pyplot as plt\n",
        "from tqdm import tqdm\n",
        "import segmentation_models_pytorch as smp\n",
        "\n",
        "# Set device\n",
        "DEVICE = \"cuda\" if torch.cuda.is_available() else \"cpu\"\n",
        "\n",
        "#######################################################\n",
        "# 1. Mappings & Helper Functions\n",
        "#######################################################\n",
        "# Load class mappings (used to display food names)\n",
        "csv_path = \"/content/drive/MyDrive/foodseg103/class_mappings.csv\"\n",
        "df_mapping = pd.read_csv(csv_path)\n",
        "yolo_to_unet = {}\n",
        "id_to_food = {0: \"background\"}\n",
        "for _, row in df_mapping.iterrows():\n",
        "    class_id = int(row[\"Class Id\"])\n",
        "    if class_id > 0:\n",
        "        yolo_id = class_id - 1  # YOLO: 0-indexed\n",
        "        unet_id = class_id      # U-Net: 0=background, 1..103=food\n",
        "        yolo_to_unet[yolo_id] = unet_id\n",
        "        id_to_food[unet_id] = row[\"Class Name\"]\n",
        "\n",
        "# Extract image and ground truth mask from a row of the parquet dataframe\n",
        "def extract_image_and_gt(row):\n",
        "    img_bytes = row['image'].get(\"bytes\")\n",
        "    if img_bytes is None:\n",
        "        raise ValueError(\"No image bytes found.\")\n",
        "    img = Image.open(io.BytesIO(img_bytes)).convert(\"RGB\")\n",
        "\n",
        "    mask_bytes = row['label'].get(\"bytes\")\n",
        "    if mask_bytes is None:\n",
        "        raise ValueError(\"No mask bytes found.\")\n",
        "    gt_mask = Image.open(io.BytesIO(mask_bytes))\n",
        "    return img, gt_mask\n",
        "\n",
        "# U-Net inference helper (identical to FusionNet validation)\n",
        "def unet_logits_full_image(img, target_size=(512,512)):\n",
        "    img_resized = img.resize(target_size, Image.BILINEAR)\n",
        "    img_arr = np.array(img_resized)\n",
        "    img_tensor = torch.from_numpy(img_arr).permute(2, 0, 1).float().to(DEVICE) / 255.0\n",
        "    mean = torch.tensor([0.485, 0.456, 0.406], device=DEVICE).view(3,1,1)\n",
        "    std  = torch.tensor([0.229, 0.224, 0.225], device=DEVICE).view(3,1,1)\n",
        "    img_tensor = (img_tensor - mean) / (std + 1e-8)\n",
        "    img_tensor = img_tensor.unsqueeze(0)\n",
        "    with torch.no_grad():\n",
        "        logits = unet_model(img_tensor)\n",
        "    return logits  # shape [1, 104, H, W]\n",
        "\n",
        "#######################################################\n",
        "# 2. Metric Functions (Same as FusionNet validation)\n",
        "#######################################################\n",
        "def compute_iou(pred, gt, num_classes=104):\n",
        "    ious = []\n",
        "    for cls in range(1, num_classes):  # exclude background\n",
        "        pred_cls = (pred == cls).astype(np.uint8)\n",
        "        gt_cls = (gt == cls).astype(np.uint8)\n",
        "        intersection = np.sum(pred_cls & gt_cls)\n",
        "        union = np.sum(pred_cls | gt_cls)\n",
        "        if union == 0:\n",
        "            continue\n",
        "        ious.append(intersection / union)\n",
        "    return np.mean(ious) if ious else 0.0\n",
        "\n",
        "def compute_dice_metric(pred, gt, num_classes=104):\n",
        "    dices = []\n",
        "    for cls in range(1, num_classes):  # exclude background\n",
        "        pred_cls = (pred == cls).astype(np.uint8)\n",
        "        gt_cls = (gt == cls).astype(np.uint8)\n",
        "        intersection = np.sum(pred_cls * gt_cls)\n",
        "        total = np.sum(pred_cls) + np.sum(gt_cls)\n",
        "        if total == 0:\n",
        "            continue\n",
        "        dices.append((2 * intersection) / total)\n",
        "    return np.mean(dices) if dices else 0.0\n",
        "\n",
        "def compute_food_f1(pred_mask, gt_mask):\n",
        "    pred_foods = set(np.unique(pred_mask)) - {0}\n",
        "    gt_foods   = set(np.unique(gt_mask)) - {0}\n",
        "    if len(pred_foods) + len(gt_foods) == 0:\n",
        "        return 1.0\n",
        "    return 2 * len(pred_foods.intersection(gt_foods)) / (len(pred_foods) + len(gt_foods))\n",
        "\n",
        "#######################################################\n",
        "# 3. Visualization Helper (4 panels & bigger figures)\n",
        "#######################################################\n",
        "def visualize_sample(sample_data, sample_metrics, title_suffix=\"\"):\n",
        "    orig_img = sample_data['orig_img']\n",
        "    pred_mask = sample_data['raw_unet_pred']\n",
        "    gt_mask = sample_data['gt_mask']\n",
        "\n",
        "    # Function to get food names (excluding background)\n",
        "    def get_food_names(mask):\n",
        "        cls_ids = set(np.unique(mask)) - {0}\n",
        "        return [id_to_food.get(cls, str(cls)) for cls in cls_ids]\n",
        "\n",
        "    pred_foods = get_food_names(pred_mask)\n",
        "    gt_foods = get_food_names(gt_mask)\n",
        "\n",
        "    # Create a 4-panel figure with larger dimensions\n",
        "    fig, axes = plt.subplots(1, 4, figsize=(25,7))\n",
        "\n",
        "    # Panel 1: Original Image\n",
        "    axes[0].imshow(orig_img)\n",
        "    axes[0].set_title(\"Original Image\")\n",
        "    axes[0].axis(\"off\")\n",
        "\n",
        "    # Panel 2: U-Net Predicted Mask\n",
        "    axes[1].imshow(pred_mask, cmap=\"jet\")\n",
        "    axes[1].set_title(\"U-Net Predicted Mask\")\n",
        "    axes[1].axis(\"off\")\n",
        "\n",
        "    # Panel 3: Ground Truth Mask\n",
        "    axes[2].imshow(gt_mask, cmap=\"jet\")\n",
        "    axes[2].set_title(\"Ground Truth Mask\")\n",
        "    axes[2].axis(\"off\")\n",
        "\n",
        "    # Panel 4: Textual information for food names and Food F1 score\n",
        "    axes[3].axis(\"off\")\n",
        "    info_text = (\n",
        "        f\"Predicted Foods: {pred_foods}\\n\\n\"\n",
        "        f\"GT Foods: {gt_foods}\\n\\n\"\n",
        "        f\"Food F1: {sample_metrics['food_f1']:.2f}\"\n",
        "    )\n",
        "    axes[3].text(0.5, 0.5, info_text, fontsize=16, ha=\"center\", va=\"center\", wrap=True)\n",
        "    axes[3].set_title(\"Food Detection Info\", fontsize=18)\n",
        "\n",
        "    plt.suptitle(\n",
        "        f\"Validation Sample {title_suffix}\\n\"\n",
        "        f\"IoU: {sample_metrics['iou']:.2f} | Dice: {sample_metrics['dice']:.2f} | Pixel Acc: {sample_metrics['pix_acc']:.2f}\",\n",
        "        fontsize=20\n",
        "    )\n",
        "    plt.tight_layout(rect=[0, 0, 1, 0.90])\n",
        "    plt.show()\n",
        "\n",
        "#######################################################\n",
        "# 4. U-Net-Only Validation Function\n",
        "#######################################################\n",
        "def validate_unet_only():\n",
        "    # Load the validation parquet file (same as used for FusionNet validation)\n",
        "    val_parquet = \"/content/drive/MyDrive/foodseg103/validation-00000-of-00001-a5bfdaa5beb7006a.parquet\"\n",
        "    df_val = pd.read_parquet(val_parquet)\n",
        "    print(f\"Validation dataset contains {len(df_val)} samples.\")\n",
        "\n",
        "    sample_results = []\n",
        "\n",
        "    unet_model.eval()\n",
        "    with torch.no_grad():\n",
        "        # Iterate over each sample\n",
        "        for idx, row in enumerate(tqdm(df_val.itertuples(), total=len(df_val), desc=\"Validating\")):\n",
        "            # Convert namedtuple row to dictionary for our helper\n",
        "            row_dict = row._asdict()\n",
        "            img, gt_mask_img = extract_image_and_gt(row_dict)\n",
        "\n",
        "            # Get U-Net logits and compute prediction\n",
        "            logits = unet_logits_full_image(img, target_size=(512,512))  # [1, 104, H, W]\n",
        "            logits = logits.squeeze(0)  # [104, H, W]\n",
        "            raw_unet_pred = torch.argmax(logits, dim=0).cpu().numpy()\n",
        "\n",
        "            # Resize ground truth mask to match target size\n",
        "            gt_mask_resized = gt_mask_img.resize((512,512), Image.NEAREST)\n",
        "            gt_mask_np = np.array(gt_mask_resized)\n",
        "\n",
        "            # Compute metrics exactly as in FusionNet validation\n",
        "            iou_val = compute_iou(raw_unet_pred, gt_mask_np, num_classes=104)\n",
        "            dice_val = compute_dice_metric(raw_unet_pred, gt_mask_np, num_classes=104)\n",
        "            pix_acc = np.sum(raw_unet_pred == gt_mask_np) / gt_mask_np.size\n",
        "            food_f1 = compute_food_f1(raw_unet_pred, gt_mask_np)\n",
        "\n",
        "            sample_results.append({\n",
        "                \"index\": idx,\n",
        "                \"orig_img\": img,\n",
        "                \"raw_unet_pred\": raw_unet_pred,\n",
        "                \"gt_mask\": gt_mask_np,\n",
        "                \"iou\": iou_val,\n",
        "                \"dice\": dice_val,\n",
        "                \"pix_acc\": pix_acc,\n",
        "                \"food_f1\": food_f1,\n",
        "            })\n",
        "\n",
        "    # Compute overall averages\n",
        "    avg_iou = np.mean([s[\"iou\"] for s in sample_results])\n",
        "    avg_dice = np.mean([s[\"dice\"] for s in sample_results])\n",
        "    avg_pix_acc = np.mean([s[\"pix_acc\"] for s in sample_results])\n",
        "    avg_food_f1 = np.mean([s[\"food_f1\"] for s in sample_results])\n",
        "\n",
        "    print(\"\\n======== Overall Validation Metrics for U-Net ========\")\n",
        "    print(f\"Average Mean IoU:       {avg_iou*100:.2f}%\")\n",
        "    print(f\"Average Mean Dice:      {avg_dice*100:.2f}%\")\n",
        "    print(f\"Average Pixel Accuracy: {avg_pix_acc*100:.2f}%\")\n",
        "    print(f\"Average Food F1 Score:  {avg_food_f1:.2f}\")\n",
        "    print(\"==============================================\")\n",
        "\n",
        "    # Visualize first 10 samples for qualitative assessment\n",
        "    print(\"\\nVisualizing first 10 validation samples...\")\n",
        "    for sample in sample_results[:10]:\n",
        "        sample_metrics = {\n",
        "            \"iou\": sample[\"iou\"],\n",
        "            \"dice\": sample[\"dice\"],\n",
        "            \"pix_acc\": sample[\"pix_acc\"],\n",
        "            \"food_f1\": sample[\"food_f1\"]\n",
        "        }\n",
        "        visualize_sample(sample, sample_metrics, title_suffix=f\"(Sample {sample['index']})\")\n",
        "\n",
        "    # Save detailed per-sample metrics to CSV if needed\n",
        "    metrics_df = pd.DataFrame([{\n",
        "        \"index\": s[\"index\"],\n",
        "        \"iou\": s[\"iou\"],\n",
        "        \"dice\": s[\"dice\"],\n",
        "        \"pixel_accuracy\": s[\"pix_acc\"],\n",
        "        \"food_f1\": s[\"food_f1\"]\n",
        "    } for s in sample_results])\n",
        "    metrics_df.to_csv(\"/content/drive/MyDrive/foodseg103/validation_metrics_unet.csv\", index=False)\n",
        "    print(\"Detailed per-sample metrics saved to validation_metrics_unet.csv\")\n",
        "\n",
